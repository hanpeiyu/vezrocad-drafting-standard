  "rules": {
    "nonOverlap": "no positive-area slot intersections",
    "noReservedZoneOverlap": "viewport slot must fit inside drawing zone; not overlap footer and title block",
    "viewportContentRect": "slot x+margin,y+titleBand+margin,width-2margin,height-titleBand-2margin",
    "titleBand": "viewport title, local 1:n scale, viewport/section reference, indexed detail number; paper-space annotation",
    "layoutViewportEntity": "CAD viewport boundary on nonplot layer, viewport remains printable even if boundary layer is nonplot",
    "layerOverrides": "per viewport VP Freeze/VP Lineweight/VP Plot Style where supported; changes do not mutate model globally",
    "sameSheetDifferentScales": true,
    "topology": "paper-space layout 1:1, per viewport model content 1:n; never use plot fit-to-paper"
  },
  "applyBehavior": {
    "locked": true,
    "noSilentReplace": true,
    "transactional": true,
    "preserveUserViewportOverrides": true,
    "annotationScalesConsistent": true,
    "refitDoesNotChangeModelGeometry": true,
    "stableViewportUid": true
  },
  "implementationCaution": "Non-rectangular VPCLIP and dynamic view boundary/annotation overhang require actual CAD 2027 tests; example only"
}
