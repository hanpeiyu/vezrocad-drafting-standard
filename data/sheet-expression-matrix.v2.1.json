  "crossDisciplineRules": [
    {
      "id": "dimensions-never-silently-hidden",
      "action": "KEEP",
      "tags": [
        "dimension",
        "annotation",
        "level"
      ],
      "condition": "required-by-sheet",
      "notes": "图纸尺寸/文字不是随背景图层直接淡化，按类型及尺寸体系独立生成"
    },
    {
      "id": "electricity-background",
      "action": "CONTEXT",
      "sheetId": "ELE-POWER",
      "tags": [
        "existing-structure",
        "furniture",
        "cabinet"
      ],
      "notes": "电气线符号优先，家具仅作定位参照"
    },
    {
      "id": "floor-tile-background",
      "action": "FOCUS",
      "sheetId": "INT-FLOOR",
      "tags": [
        "floor-finish",
        "tile-joint"
      ],
      "notes": "地面铺贴突出，家具不参与遮罩时可隐藏"
    },
    {
      "id": "mask-is-not-category",
      "action": "KEEP",
      "tags": [],
      "condition": "WIPEOUT_MASK coupled to owning visible object",
      "notes": "遮罩跟随构件的可见性，不能按专业全局提到最上"
    },
    {
      "id": "demolition-readability",
      "action": "KEEP",
      "sheetId": "BLD-DEMO",
      "tags": [
        "demolition"
      ],
      "condition": "linetype+notes required in BW",
      "notes": "不能仅靠红色和黄色表示拆新"
    }
  ],
  "printResolution": {
    "defaultSource": "sheetType.suggested.outputMode",
    "modeSet": [
      "BW",
      "GRAY",
      "COLOR",
      "PRESENTATION"
    ],
    "requiresV21Stb": false,
    "actualStbReady": false,
    "unavailableModePolicy": "do-not-plot-as-certified; warn and require reviewed fallback",
    "lineweightSource": "sheetType.suggested.scaleDenominator -> paper/scales preset -> VP Lineweight",
    "layoutScale": "1:1"
  },
  "notLayerExplosion": "semantic tags do not imply one CAD layer per tag; resolve to existing role/layer rules",
  "unknownTagAcknowledgement": "new discipline tags proposed, SmartCAD integration requires an approved mapping ADR"
}
